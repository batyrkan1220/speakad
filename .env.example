# https://fal.ai/dashboard/keys
FAL_KEY=
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Supabase: database, file storage (bucket "media") and logs.
# Project Settings -> API: URL and the secret key (sb_secret_... or legacy service_role).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Analytics & Automation Control Center (/analytics) ---
# ANALYTICS_SOURCE=mock            # force the built-in demo data even when the tables exist
# ANALYTICS_WORKSPACE_ID=ws_demo   # which workspace row the dashboard reads
# ANALYTICS_CRON_SECRET=           # external cron calls POST /api/analytics/sync with header x-cron-secret
# META_APP_ID=                     # Meta app (debug_token + token refresh)
# META_APP_SECRET=
# IG_GRAPH_VERSION=v23.0
# IG_GRAPH_HOST=graph.facebook.com # or graph.instagram.com for Instagram-Login tokens
# IG_INSIGHT_DAYS=30               # Reels older than this stop being polled
# IG_MAX_REELS_PER_SYNC=60
# IG_SYNC_CONCURRENCY=4
